{
  "FastGithub": {
    "DomainConfigs": {
      "github.com": {
        "TlsSni": false
      },
      "api.github.com": {
        "TlsSni": false
      },
      "githubstatus.com": {
        "TlsSni": false
      },
      "gist.github.com": {
        "TlsIgnoreNameMismatch": true
      },
      "vscode-auth.github.com": {
        "TlsSni": true
      },
      "*.github.com": {
        "TlsIgnoreNameMismatch": true
      },
      "codeload.github.com": {
        "TlsIgnoreNameMismatch": true,
        "SpeedTestUri": "https://codeload.github.com/git/git/tar.gz/refs/tags/v2.0.0"
      },
      "raw.githubusercontent.com": {
        "TlsIgnoreNameMismatch": true,
        "SpeedTestUri": "https://raw.githubusercontent.com/git/git/master/contrib/completion/git-completion.bash"
      },
      "*.github.io": {
        "TlsIgnoreNameMismatch": true
      },
      "*.githubapp.com": {
        "TlsIgnoreNameMismatch": true
      },
      "*.githubassets.com": {
        "TlsIgnoreNameMismatch": true
      },
      "*.githubusercontent.com": {
        "TlsIgnoreNameMismatch": true
      }
    }
  }
}